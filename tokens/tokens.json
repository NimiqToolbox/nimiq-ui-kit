{
  "$meta": {
    "name": "Nimiq Design Tokens",
    "grid": "8px (1rem = 8px)",
    "sources": {
      "@nimiq/style": "0.8.5 — nimiq-style/src/{theme,typography,layout,main}.css",
      "nimiq-wallet": "wallet/src/scss/{themes,variables}.scss, App.vue"
    }
  },
  "color": {
    "brand": {
      "blue":        { "hex": "#1F2348", "rgb": "31, 35, 72",    "var": "--nimiq-blue",        "text": "nq-blue",        "bg": "nq-blue-bg" },
      "light-blue":  { "hex": "#0582CA", "rgb": "5, 130, 202",   "var": "--nimiq-light-blue",  "text": "nq-light-blue",  "bg": "nq-light-blue-bg" },
      "gold":        { "hex": "#E9B213", "rgb": "233, 178, 19",  "var": "--nimiq-gold",        "text": "nq-gold",        "bg": "nq-gold-bg" },
      "green":       { "hex": "#21BCA5", "rgb": "33, 188, 165",  "var": "--nimiq-green",       "text": "nq-green",       "bg": "nq-green-bg" },
      "orange":      { "hex": "#FC8702", "rgb": "252, 135, 2",   "var": "--nimiq-orange",      "text": "nq-orange",      "bg": "nq-orange-bg" },
      "red":         { "hex": "#D94432", "rgb": "216, 65, 51",   "var": "--nimiq-red",         "text": "nq-red",         "bg": "nq-red-bg" },
      "purple":      { "hex": "#5F4B8B", "rgb": "95, 75, 139",   "var": "--nimiq-purple",      "text": "nq-purple",      "bg": "nq-purple-bg" },
      "pink":        { "hex": "#FA7268", "rgb": "250, 114, 104", "var": "--nimiq-pink",        "text": "nq-pink",        "bg": "nq-pink-bg" },
      "light-green": { "hex": "#88B04B", "rgb": "136, 176, 75",  "var": "--nimiq-light-green", "text": "nq-light-green", "bg": "nq-light-green-bg" },
      "brown":       { "hex": "#795548", "rgb": "121, 85, 72",   "var": "--nimiq-brown",       "text": "nq-brown",       "bg": "nq-brown-bg" }
    },
    "neutral": {
      "gray":       { "hex": "#F4F4F4", "var": "--nimiq-gray",       "bg": "nq-gray-bg" },
      "light-gray": { "hex": "#FAFAFA", "var": "--nimiq-light-gray" },
      "white":      { "hex": "#FFFFFF", "var": "--nimiq-white" }
    },
    "on-dark": {
      "light-blue-on-dark": { "hex": "#0CA6FE", "var": "--nimiq-light-blue-on-dark" },
      "red-on-dark":        { "hex": "#FF5C48", "var": "--nimiq-red-on-dark" }
    },
    "darkened": {
      "blue": "#151833", "light-blue": "#0071C3", "gold": "#E5A212",
      "green": "#20B29E", "orange": "#FC7500", "red": "#D13030"
    },
    "special": {
      "highlight-bg": { "value": "rgba(31, 35, 72, 0.06)", "var": "--nimiq-highlight-bg" },
      "card-bg":      { "value": "#FFFFFF", "var": "--nimiq-card-bg" }
    },
    "crypto": {
      "bitcoin": { "hex": "#F7931A", "var": "--bitcoin-orange" },
      "usdc":    { "hex": "#2775CA", "var": "--usdc-blue" },
      "usdt":    { "hex": "#009393", "var": "--usdt-green" }
    },
    "text-opacity-ladder": {
      "description": "Nimiq Blue at descending alpha — the wallet's greyscale text system",
      "steps": [100, 80, 70, 60, 50, 40, 35, 30, 25, 22, 20, 16, 14, 12, 10, 6],
      "formula": "rgba(31, 35, 72, step/100)"
    }
  },
  "gradient": {
    "formula": "radial-gradient(100% 100% at bottom right, <accent>, var(--nimiq-<base>))",
    "blue":        { "accent": "#260133", "var": "--nimiq-blue-bg" },
    "light-blue":  { "accent": "#265DD7", "var": "--nimiq-light-blue-bg" },
    "gold":        { "accent": "#EC991C", "var": "--nimiq-gold-bg" },
    "green":       { "accent": "#41A38E", "var": "--nimiq-green-bg" },
    "orange":      { "accent": "#FD6216", "var": "--nimiq-orange-bg" },
    "red":         { "accent": "#CC3047", "var": "--nimiq-red-bg" },
    "purple":      { "accent": "#4D4C96", "var": "--nimiq-purple-bg" },
    "pink":        { "accent": "#E0516B", "var": "--nimiq-pink-bg" },
    "light-green": { "accent": "#70B069", "var": "--nimiq-light-green-bg" },
    "brown":       { "accent": "#724147", "var": "--nimiq-brown-bg" }
  },
  "typography": {
    "font-family": "'Muli', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
    "font-family-mono": "'Fira Mono', monospace",
    "weights": [400, 600, 700],
    "scale": {
      "body":   { "rem": 2.25, "px": 18, "class": null },
      "h1":     { "rem": 3,    "px": 24, "class": "nq-h1",     "weight": 700, "line-height": 1.2 },
      "h2":     { "rem": 2.5,  "px": 20, "class": "nq-h2",     "weight": 700, "line-height": 1.2 },
      "h3":     { "rem": 2,    "px": 16, "class": "nq-h3",     "weight": 700, "line-height": 1.2 },
      "text":   { "rem": 2,    "px": 16, "class": "nq-text",   "color": "rgba(31,35,72,0.7)" },
      "text-s": { "rem": 1.75, "px": 14, "class": "nq-text-s", "weight": 600 },
      "label":  { "rem": 1.75, "px": 14, "class": "nq-label",  "weight": 600, "transform": "uppercase", "letter-spacing": "0.107em" }
    }
  },
  "spacing": {
    "base": "8px",
    "note": "Nrem = N × 8px. Utilities: .margin-top-1..5 → 8..40px",
    "scale-px": [8, 16, 24, 32, 40]
  },
  "radius": {
    "input": { "rem": 0.5, "px": 4 },
    "card": { "rem": 1.25, "px": 10 },
    "small-button": { "rem": 1.6875, "px": 13.5 },
    "pill-button": "500px"
  },
  "shadow": {
    "nq-shadow":   "0 0.5rem 1.5rem rgba(0,0,0,0.15)",
    "nq-shadow-l": "0 0.5rem 2.5rem rgba(0,0,0,0.15)",
    "card":        "0 0.5rem 3.5rem rgba(0,0,0,0.111158)"
  },
  "motion": {
    "ease":  { "value": "cubic-bezier(0.25, 0, 0, 1)", "var": "--nimiq-ease" },
    "attr-duration":     { "value": "0.2s", "var": "--attr-duration" },
    "movement-duration": { "value": "0.4s", "var": "--movement-duration" },
    "button-spring": "cubic-bezier(0.41, 0.34, 0.26, 1.55)"
  },
  "breakpoints-px": {
    "mobile": 768, "tablet": 960, "halfMobile": 1160, "smallDesktop": 1199,
    "mediumDesktop": 1319, "largeDesktop": 1409, "extraLargeDesktop": 1499,
    "veryLargeDesktop": 1800, "ultraLargeDesktop": 2000
  },
  "layout-rem": {
    "sidebar-width": 24, "settings-width": 131, "address-column-width": 150
  }
}
